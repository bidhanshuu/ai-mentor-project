# ============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Instructions:
# 1. Copy this file to .env
# 2. Configure backend URLs based on your environment
# 3. NEVER commit .env to GitHub - it's in .gitignore
# ============================================================================

# Backend API URLs - Update these for your environment
# For local development:
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_BASE_URL=ws://127.0.0.1:8000

# For production deployment:
# VITE_API_BASE_URL=https://your-deployed-backend.com
# VITE_WS_BASE_URL=wss://your-deployed-backend.com
