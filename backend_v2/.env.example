# ============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to GitHub - it's in .gitignore
# ============================================================================

# Google Gemini API Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=models/gemini-2.0-flash

# Timeout and Retry Settings
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=3

# Optional: Skip API validation during testing (set to "true" if needed)
AUTOMENTOR_SKIP_API_VALIDATION=false

# Database Configuration (if using PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost/automentor_db

# Application Settings (optional)
# DEBUG=false
# PORT=8000
# HOST=0.0.0.0
